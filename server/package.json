{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#config": "./src/config/config.js",
    "#constants": "./src/constants/index.js",
    "#db/*": "./src/db/*",
    "#errors": "./src/errors/index.js",
    "#middlewares": "./src/middlewares/index.js",
    "#repository": "./src/repository/index.js",
    "#utils": "./src/utils/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=./env/.env.development src/server.js",
    "start": "node --env-file-if-exists=./env/.env.production src/server.js",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
